{
  "name": "Mana",
  "description": "Locked quizzes for Chromium! Ported from Firefox.",
  "version": "0.0.1",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "*://forms.google.com/*",
    "*://docs.google.com/*"
  ],
  "background": {
    "service_worker": "src/main.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://forms.google.com/*",
        "*://docs.google.com/forms/*",
        "*://docs.google.com/forms/*/startquiz",
        "*://docs.google.com/*/forms/*/startquiz"
      ],
      "js": ["src/backend.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://forms.google.com/*",
        "*://docs.google.com/forms/*",
        "*://docs.google.com/forms/*/startquiz",
        "*://docs.google.com/*/forms/*/startquiz"
      ],
      "js": ["src/content-script.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}